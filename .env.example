# DevTimesheet Configuration

# Application Environment
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Security: JWT Secret (min 32 characters)
SECRET_KEY=generate_a_random_secure_jwt_secret_key_here_minimum_32_chars

# Security: AES-256-GCM Master Key for encrypting Azure DevOps PATs (32 bytes base64 encoded)
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
PAT_ENCRYPTION_KEY=

# Local SQLite Database Path
DATABASE_URL=sqlite:///./data/devtimesheet.db

# Google Gemini API Key for daily activity summarization
GEMINI_API_KEY=

# Default Azure DevOps Organization URLs (Users can override or configure in settings)
DEFAULT_CLIENT_ORG_URL=https://dev.azure.com/client-org
DEFAULT_RYSUN_ORG_URL=https://dev.azure.com/rysun

# Timesheet Project Defaults
DEFAULT_CLIENT_NAME=Visual Comfort and Co
DEFAULT_ITERATION=Rysun Project Management
